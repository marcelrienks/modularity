{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fusion 360 Export Model Schema",
  "description": "Schema for model.json produced by Fusion 360 export script (export_fusion360_data.py)",
  "type": "object",
  "required": ["export_metadata", "model", "parameters", "features"],
  "properties": {
    "export_metadata": {
      "type": "object",
      "title": "Export Context",
      "required": ["version", "exported_date", "fusion360_version"],
      "properties": {
        "version": {
          "type": "string",
          "description": "Schema version (e.g., '1.0')"
        },
        "exported_date": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of export"
        },
        "source_file": {
          "type": "string",
          "description": "Original .f3d filename"
        },
        "fusion360_version": {
          "type": "string",
          "description": "Fusion 360 version used for export"
        },
        "export_method": {
          "type": "string",
          "description": "Method used for export (e.g., 'fissionreactor_add_in')"
        }
      }
    },
    "model": {
      "type": "object",
      "title": "Model Summary",
      "required": ["name", "part_count"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Model name (must match .f3d filename without extension)"
        },
        "description": {
          "type": "string",
          "description": "Model description"
        },
        "part_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of parts/bodies in model"
        },
        "body_count": {
          "type": "integer",
          "description": "Number of bodies"
        },
        "feature_count": {
          "type": "integer",
          "description": "Total number of features"
        },
        "parameter_count": {
          "type": "integer",
          "description": "Number of design parameters"
        }
      }
    },
    "parameters": {
      "type": "array",
      "title": "Design Parameters",
      "description": "All user-defined parameters from the model",
      "items": {
        "type": "object",
        "required": ["name", "type", "value"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Parameter name (should be PascalCase)"
          },
          "type": {
            "type": "string",
            "enum": ["length", "angle", "text", "integer", "real"],
            "description": "Parameter type"
          },
          "value": {
            "type": ["number", "string"],
            "description": "Current/default value"
          },
          "unit": {
            "type": "string",
            "description": "Unit of measurement (e.g., 'mm', 'deg')"
          },
          "min": {
            "type": "number",
            "description": "Minimum value (if constrained)"
          },
          "max": {
            "type": "number",
            "description": "Maximum value (if constrained)"
          },
          "step": {
            "type": ["number", "null"],
            "description": "Recommended increment for parameter variation"
          },
          "used_in_features": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of features that use this parameter"
          },
          "note": {
            "type": "string",
            "description": "Optional notes about the parameter"
          }
        }
      }
    },
    "features": {
      "type": "array",
      "title": "Design Features",
      "description": "Feature timeline in construction order",
      "items": {
        "type": "object",
        "required": ["name", "type", "order"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Feature name"
          },
          "type": {
            "type": "string",
            "enum": ["extrude", "pocket", "hole", "sketch", "fillet", "chamfer", "pattern", "mirror", "offset", "other"],
            "description": "Feature type"
          },
          "order": {
            "type": "integer",
            "description": "Position in timeline (0-indexed)"
          },
          "description": {
            "type": "string",
            "description": "Feature description"
          },
          "parameters": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Parameters used in this feature"
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Features that this one depends on"
          },
          "sketch": {
            "type": "string",
            "description": "Associated sketch name (if any)"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "title": "Component Structure",
      "description": "Sub-components and assemblies",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "parent": { "type": "string" },
          "feature_count": { "type": "integer" },
          "sketch_count": { "type": "integer" }
        }
      }
    },
    "sketches": {
      "type": "array",
      "title": "Sketches",
      "description": "Sketch definitions (optional)",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "plane": { "type": "string" },
          "constraints": { "type": "integer" },
          "geometry_items": { "type": "integer" }
        }
      }
    },
    "timeline": {
      "type": "array",
      "title": "Design Timeline",
      "description": "Complete feature timeline with dependencies",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "order": { "type": "integer" }
        }
      }
    }
  },
  "examples": [
    {
      "export_metadata": {
        "version": "1.0",
        "exported_date": "2026-01-27T09:00:00Z",
        "source_file": "ShelfBracket_v1.f3d",
        "fusion360_version": "2.0.x"
      },
      "model": {
        "name": "ShelfBracket_v1",
        "part_count": 1,
        "feature_count": 12,
        "parameter_count": 8
      },
      "parameters": [
        {
          "name": "BaseWidth",
          "type": "length",
          "value": 200,
          "unit": "mm",
          "min": 100,
          "max": 300
        }
      ],
      "features": [
        {
          "name": "Base Extrude",
          "type": "extrude",
          "order": 0,
          "parameters": ["BaseWidth", "BaseDepth"]
        }
      ]
    }
  ]
}
