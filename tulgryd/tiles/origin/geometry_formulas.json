{
  "coordinate_calculations": {
    "interior_holes": {
      "description": "Calculate XY positions for interior grid holes",
      "formula": {
        "x_position": "offset_x + (col_index * grid_spacing)",
        "y_position": "offset_y + (row_index * grid_spacing)",
        "z_start": 0,
        "z_end": "plate_thickness"
      },
      "iteration": {
        "row_index": "0 to (grid_rows - 1)",
        "col_index": "0 to (grid_cols - 1)"
      }
    },
    "cylinders": {
      "description": "Calculate positions for support cylinders (same as holes)",
      "formula": {
        "center_x": "offset_x + (col_index * grid_spacing)",
        "center_y": "offset_y + (row_index * grid_spacing)",
        "radius": "cylinder_diameter / 2",
        "height": "cylinder_height"
      }
    },
    "top_edge_tabs": {
      "description": "Calculate positions for tabs on top edge (Y=100)",
      "formula": {
        "center_x": "start_offset + (index * spacing)",
        "center_y": "plate_width",
        "radius": "tab_radius",
        "arc": "180 degrees facing outward (+Y direction)"
      },
      "iteration": {
        "index": "0 to (tab_count_per_edge - 1)"
      }
    },
    "right_edge_tabs": {
      "description": "Calculate positions for tabs on right edge (X=100)",
      "formula": {
        "center_x": "plate_length",
        "center_y": "start_offset + (index * spacing)",
        "radius": "tab_radius",
        "arc": "180 degrees facing outward (+X direction)"
      },
      "iteration": {
        "index": "0 to (tab_count_per_edge - 1)"
      }
    },
    "bottom_edge_slots": {
      "description": "Calculate positions for slots on bottom edge (Y=0)",
      "formula": {
        "center_x": "start_offset + (index * spacing)",
        "center_y": 0,
        "radius": "slot_radius",
        "arc": "180 degrees facing inward (-Y direction)"
      },
      "iteration": {
        "index": "0 to (slot_count_per_edge - 1)"
      }
    },
    "left_edge_slots": {
      "description": "Calculate positions for slots on left edge (X=0)",
      "formula": {
        "center_x": 0,
        "center_y": "start_offset + (index * spacing)",
        "radius": "slot_radius",
        "arc": "180 degrees facing inward (-X direction)"
      },
      "iteration": {
        "index": "0 to (slot_count_per_edge - 1)"
      }
    }
  },
  "profile_sketches": {
    "perimeter_frame": {
      "description": "2D sketch for perimeter with integrated tabs/slots",
      "outer_rectangle": {
        "points": [
          [0, 0],
          ["plate_length", 0],
          ["plate_length", "plate_width"],
          [0, "plate_width"]
        ]
      },
      "inner_rectangle_offset": "wall_thickness",
      "tabs_on_edges": "Add semicircular protrusions at calculated positions",
      "slots_on_edges": "Add semicircular cutouts at calculated positions"
    },
    "top_layer": {
      "description": "Solid rectangular sketch covering entire area",
      "rectangle": {
        "corner1": [0, 0],
        "corner2": ["plate_length", "plate_width"]
      },
      "note": "Extends from tabs to cover area, unites all components"
    }
  },
  "extrusion_operations": {
    "step1_perimeter_and_cylinders": {
      "operation": "Extrude",
      "profiles": ["perimeter_frame_sketch", "cylinder_circles (100x)"],
      "direction": "+Z",
      "distance": "perimeter_wall_height (3.5mm)",
      "result": "Separate bodies: 1 perimeter + 100 cylinders"
    },
    "step2_top_layer": {
      "operation": "Extrude",
      "profile": "top_layer_sketch",
      "start_plane": "Z = perimeter_wall_height",
      "distance": "top_layer_thickness (2.5mm)",
      "join_operation": "Unite all bodies into single solid"
    },
    "step3_interior_holes": {
      "operation": "Hole feature (circular pattern or loop)",
      "diameter": "hole_diameter",
      "depth": "Through all (plate_thickness)",
      "positions": "Grid calculated positions (100 holes)"
    },
    "note": "Tabs and slots are already part of perimeter sketch and extend through both extrusions"
  },
  "boolean_operations": {
    "union": {
      "description": "Unite perimeter frame, 100 cylinders, and top layer",
      "components": [
        "perimeter_frame_body",
        "cylinder_bodies[0..99]",
        "top_layer_body"
      ],
      "result": "Single manifold solid"
    },
    "subtraction": {
      "description": "Remove material for holes",
      "from": "unified_body",
      "subtract": "100 x Ø4mm cylinders through full height"
    }
  }
}
